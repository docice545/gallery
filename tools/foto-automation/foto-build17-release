def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='No stage runs without an explicit mode. No automatic sudo/retry/deployment.')
    parser.add_argument('--config', type=Path, help='Owned 0600 JSON; required except --receive-apk')
    modes = parser.add_mutually_exclusive_group(required=True)
    for mode in ('check', 'prepare', 'test', 'build', 'verify', 'resume'):
        modes.add_argument('--' + mode, action='store_true')
    modes.add_argument('--finalize', action='store_true',
                       help='Explicit prepare/test/build/verify in tmux; existing key only, no deployment or automatic retry')
    modes.add_argument('--receive-apk', type=Path, metavar='PUBLIC_RECEIPT')
    parser.add_argument('--retry-failed', action='store_true', help='Explicit one-attempt retry of failed/interrupted stages')
    parser.add_argument('--diagnosis', default='', help='Sanitized operator diagnosis; never a command or password')
    parser.add_argument('--certificate-pin-format-proof', type=Path, metavar='ORIGINAL_CONFIG',
                        help='Read-only owned 0600 original matching the checkpoint; admit only colon/case pin normalization')
    args = parser.parse_args()
    if args.receive_apk:
        receive(args.receive_apk)
        return
    need(args.config, 'CONFIG_REQUIRED')
    c = config(args.config)
    need(pwd.getpwuid(os.getuid()).pw_name == 'codex-gallery' and os.getuid() != 0,
         'RUN_AS_CODEX_GALLERY_NO_AUTOMATIC_PRIVILEGE_ESCALATION')
    if args.finalize:
        need(os.environ.get('TMUX'), 'FINALIZE_REQUIRES_TMUX')
    p = Pipeline(c, args.retry_failed, args.diagnosis, args.certificate_pin_format_proof)
    if args.check:
        # Intentionally no mkdir, locks, fetch, codegen, tool installation or state writes.
        result = {}
        if args.certificate_pin_format_proof:
            p.read_checkpoint()
            result['checkpointConfigValidation'] = 'PASS_CERTIFICATE_PIN_FORMAT_EQUIVALENT'
        result.update(inventory(c))
        print(json.dumps(result, indent=2))
        return
    snapshot = inventory(c)
    with p.locked():
        runner.atomic_json(p.state / ('inventory-' + uuid.uuid4().hex + '.json'), snapshot)
        mode = next(x for x in ('prepare', 'test', 'build', 'verify', 'resume', 'finalize') if getattr(args, x))
        if mode == 'resume':
            need(p.manifest, 'NO_CHECKPOINT_TO_RESUME')
            mode = p.manifest['mode']
        if mode in ('prepare', 'finalize'):
            getattr(p, mode)()
        else:
            need(p.manifest and p.manifest.get('prepared'), 'PREPARE_REQUIRED')
            p.manifest['mode'] = mode
            p.save(mode.upper() + '_SELECTED')
            getattr(p, mode)()


if __name__ == '__main__':
    try:
        main()
    except (Stop, OSError, ValueError, KeyError, TypeError, AttributeError, tarfile.TarError, zipfile.BadZipFile) as error:
        # Never echo subprocess output, configuration contents, passwords or tokens.
        print('STOP', str(error) if isinstance(error, Stop) else type(error).__name__ + '_SEE_PRIVATE_STATE', file=sys.stderr)
        sys.exit(1)
