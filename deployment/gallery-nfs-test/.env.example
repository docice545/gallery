# Copy to .env only after choosing a dedicated test image and secret.
GALLERY_SERVER_IMAGE=gallery-server:docice-work

# The parent media directory, database directory and Redis directory are all
# dedicated SSD paths. Do not point any of them at /mnt/hp-data/immich.
SSD_MEDIA_ROOT=/mnt/hp-data/gallery-nfs-test/media
SSD_DB_ROOT=/mnt/hp-data/gallery-nfs-test/postgres
SSD_REDIS_ROOT=/mnt/hp-data/gallery-nfs-test/redis

# This must already be mounted from exactly 10.10.10.95:/volume1/Gallery-Test.
NFS_TEST_ROOT=/mnt/gallery-nfs-test

DB_USERNAME=gallery_nfs_test
DB_PASSWORD=replace-with-a-dedicated-alphanumeric-secret
DB_DATABASE_NAME=gallery_nfs_test
